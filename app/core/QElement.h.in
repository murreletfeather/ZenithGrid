/** @file QElement.h
 * @brief 从原生枚举声明生成 QML 的 Element 类型，禁止另行维护映射。
 */
#pragma once
#include <QObject>
#include <qqmlintegration.h>

/** @brief 将统一选择类型暴露为 QML 的 Element.Face 等枚举值。 */
class Element : public QObject {
    Q_OBJECT
    QML_ELEMENT
public:
    // clang-format off
@ElementEnum_H_CONTENT@
    // clang-format on
    Q_ENUM(Type)
};
